# Datenbank-Verbindung (PostgreSQL)
# Fuer pg-kompatibles TLS ohne Alias-Warnung: sslmode=verify-full verwenden.
DATABASE_URL="postgres://user:password@localhost:5432/zahnarzt_db?sslmode=verify-full"

# NextAuth.js Konfiguration
# NEXTAUTH_SECRET: min. 32 Zeichen, zufaellig generieren mit:
#   node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64'))"
NEXTAUTH_URL="https://ihre-domain.de"
NEXTAUTH_SECRET="hier-einen-sicheren-zufallsstring-generieren"

# Admin-Erstbenutzer (nur fuer Seeding)
ADMIN_EMAIL="admin@zeitzer-zahnarzt.de"
ADMIN_PASSWORD="sicheres-passwort-hier"

# Reverse-Proxy-Betrieb:
# TRUST_PROXY=true ist erforderlich, wenn die App hinter einem vertrauenswuerdigen
# Reverse Proxy (z.B. Nginx, Traefik) laeuft, der x-real-ip / x-forwarded-for
# korrekt ueberschreibt. Ohne diese Kombination schlagen Login-Lockout,
# Kontaktformular-Rate-Limit und /api/log/client-error in Produktion fail-closed fehl.
# Auf Vercel NICHT setzen; dort wird x-vercel-forwarded-for automatisch verwendet.
# TRUST_PROXY=true

# Logging (optional)
# LOG_LEVEL=info
