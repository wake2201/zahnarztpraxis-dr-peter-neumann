// Prisma Schema für Zahnarztpraxis Dr. Peter Neumann
// Datenbank: PostgreSQL

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentConfirmationMode {
  AUTO
  MANUAL
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum AppointmentSource {
  ONLINE
  ADMIN
}

enum AppointmentAvailabilityExceptionKind {
  OPEN
  BLOCK
}

/// Kontaktanfragen von Patienten über das Website-Formular.
/// DSGVO-Hinweis: Einträge können unwiderruflich gelöscht werden (Art. 17 DSGVO – Recht auf Löschung).
model ContactRequest {
  id          String   @id @default(cuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  countryCode String   @default("+49") @map("country_code")
  phone       String
  message     String   @db.Text
  gdprConsent Boolean  @default(true) @map("gdpr_consent")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_requests")
}

/// Admin-/Mitarbeiter-Benutzer für den geschützten Verwaltungsbereich.
/// Rollen: "admin" (inkl. Konfiguration, Benutzerverwaltung, Logs) | "staff" (Anfragen und Termine verwalten)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt-gehashed
  name      String?
  role      String   @default("staff") // "admin" | "staff"
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

/// Login-Versuche für DB-basiertes Rate-Limiting.
/// Identifier = SHA-256(Bucket-Typ + IP + UserAgent + optionaler Konto-Kontext) — nicht umkehrbar.
model LoginAttempt {
  id          String    @id @default(cuid())
  identifier  String    @unique
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([lockedUntil])
  @@map("login_attempts")
}

/// Audit-Log: Protokolliert sicherheitsrelevante Verwaltungs- und Terminaktionen ohne Patienten-PII.
/// Nur für Admin-Benutzer sichtbar.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  action    String   // Login-, Benutzer-, Anfrage-, Termin- und Buchungskonfigurationsaktionen
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

/// DB-basiertes Rate-Limiting für öffentliche Kontakt-, Fehler- und Terminendpunkte.
/// Ersetzt die In-Memory Map, damit das Limit serverless-/multi-instance-sicher ist.
model RateLimit {
  id        String   @id @default(cuid())
  ip        String   @unique
  attempts  Int      @default(0)
  lastReset DateTime @default(now()) @map("last_reset")

  @@index([lastReset])
  @@map("rate_limits")
}

/// Zentrale, bewusst als Singleton verwendete Buchungskonfiguration.
model AppointmentSettings {
  id                   String   @id @default("default")
  slotMinutes          Int      @default(15) @map("slot_minutes")
  minimumNoticeMinutes Int      @default(240) @map("minimum_notice_minutes")
  bookingHorizonDays   Int      @default(60) @map("booking_horizon_days")
  timeZone             String   @default("Europe/Berlin") @map("time_zone")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("appointment_settings")
}

/// Administrativ gepflegte Terminart. Bestehende Termine behalten Snapshots.
model AppointmentType {
  id               String                      @id @default(cuid())
  name             String
  description      String?                     @db.Text
  durationMinutes  Int                         @map("duration_minutes")
  active           Boolean                     @default(true)
  onlineBookable   Boolean                     @default(true) @map("online_bookable")
  confirmationMode AppointmentConfirmationMode @map("confirmation_mode")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  appointments     Appointment[]

  @@index([active, onlineBookable])
  @@map("appointment_types")
}

/// Wiederkehrendes lokales Wochenfenster fuer die Online-Buchung.
model AppointmentWeeklyAvailability {
  id          String   @id @default(cuid())
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([weekday, startMinute, endMinute])
  @@index([weekday])
  @@map("appointment_weekly_availability")
}

/// Datumsbezogene Oeffnung oder Sperre; BLOCK hat in der Engine Vorrang.
model AppointmentAvailabilityException {
  id          String                                   @id @default(cuid())
  localDate   DateTime                                 @db.Date @map("local_date")
  kind        AppointmentAvailabilityExceptionKind
  startMinute Int                                      @map("start_minute")
  endMinute   Int                                      @map("end_minute")
  createdAt   DateTime                                 @default(now()) @map("created_at")
  updatedAt   DateTime                                 @updatedAt @map("updated_at")

  @@unique([localDate, kind, startMinute, endMinute])
  @@index([localDate, kind])
  @@map("appointment_availability_exceptions")
}

/// Termin inklusive historischer Typ-Snapshots und Patientenkontaktdaten.
model Appointment {
  id                       String                      @id @default(cuid())
  appointmentTypeId        String                      @map("appointment_type_id")
  typeNameSnapshot         String                      @map("type_name_snapshot")
  durationMinutesSnapshot  Int                         @map("duration_minutes_snapshot")
  confirmationModeSnapshot AppointmentConfirmationMode @map("confirmation_mode_snapshot")
  firstName                String                      @map("first_name")
  lastName                 String                      @map("last_name")
  countryCode              String                      @default("+49") @map("country_code")
  phone                    String
  details                  String?                     @db.Text
  gdprConsent              Boolean                     @map("gdpr_consent")
  consentedAt              DateTime                    @default(now()) @db.Timestamptz(3) @map("consented_at")
  startAt                  DateTime                    @db.Timestamptz(3) @map("start_at")
  endAt                    DateTime                    @db.Timestamptz(3) @map("end_at")
  status                   AppointmentStatus
  source                   AppointmentSource
  managementCodeHash       String?                     @unique @db.Char(64) @map("management_code_hash")
  revision                 Int                         @default(0)
  createdAt                DateTime                    @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt                DateTime                    @updatedAt @db.Timestamptz(3) @map("updated_at")
  appointmentType          AppointmentType             @relation(fields: [appointmentTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  slots                    AppointmentSlot[]
  accessSession            AppointmentAccessSession?

  @@index([status, startAt])
  @@index([appointmentTypeId, startAt])
  @@map("appointments")
}

/// Eine globale Kapazitaetseinheit pro UTC-15-Minuten-Startzeit.
model AppointmentSlot {
  appointmentId String      @map("appointment_id")
  slotStartAt   DateTime    @unique @db.Timestamptz(3) @map("slot_start_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([appointmentId, slotStartAt])
  @@map("appointment_slots")
}

/// Kurzlebige, gehashte Patientensession; genau eine aktive Session pro Termin.
model AppointmentAccessSession {
  id            String      @id @default(cuid())
  appointmentId String      @unique @map("appointment_id")
  tokenHash     String      @unique @db.Char(64) @map("token_hash")
  expiresAt     DateTime    @db.Timestamptz(3) @map("expires_at")
  createdAt     DateTime    @default(now()) @db.Timestamptz(3) @map("created_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
  @@map("appointment_access_sessions")
}
