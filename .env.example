# Datenbank-Verbindung (PostgreSQL)
DATABASE_URL="postgres://user:password@localhost:5432/zahnarzt_db?sslmode=require"

# NextAuth.js Konfiguration
# NEXTAUTH_SECRET: min. 32 Zeichen, zufällig generieren mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NEXTAUTH_URL="https://zahnarzt-neumann.vercel.app"
NEXTAUTH_SECRET="hier-einen-sicheren-zufallsstring-generieren"

# Admin-Erstbenutzer (nur für Seeding)
ADMIN_EMAIL="admin@zeitzer-zahnarzt.de"
ADMIN_PASSWORD="sicheres-passwort-hier"

# Rate-Limit / Login-Lockout vertrauen nur dann auf x-real-ip / x-forwarded-for,
# wenn die App hinter einem Reverse-Proxy (Nginx, Traefik) steht, der diese Header
# überschreibt. Auf Vercel NICHT setzen (nutzt x-vercel-forwarded-for automatisch).
# TRUST_PROXY=false

# Logging (optional)
# LOG_LEVEL=info
